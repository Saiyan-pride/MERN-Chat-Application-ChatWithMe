PORT=port
MONGO_URI=your_mongodb_connection_uri
JWT_SECRET=your_jwt_secret_key
NODE_ENV=development

# SMTP Email Configuration (for Password Reset OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
EMAIL_FROM=ChatWithMe <your_email@gmail.com>

# Google Gemini API (Phase 2: AI Integration)
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio

# AI Usage Management Limits
AI_LIMIT_ASSISTANT_DAILY=xx
AI_LIMIT_SMART_REPLY_DAILY=xx
AI_LIMIT_SUMMARIZE_DAILY=x
AI_LIMIT_POLISH_DAILY=xx
AI_LIMIT_COMBINED_DAILY=xx
AI_LIMIT_PER_MINUTE=x
